server_ip: "YOUR_SERVER_IP"
server_hostname: "YOUR_HOSTNAME"
server_timezone: "Europe/Paris"

ssh_port: 2222
# Public keys allowed to log in as root (password login is disabled by 02-ssh-setup)
ssh_authorized_keys:
  - "ssh-ed25519 AAAA... your_key_comment"
ssh_admin_email: "admin@example.com"

apache_port: 8085
nginx_default_port: 80
nginx_https_port: 443

php_version: "8.6"
# A major version, not "node": nodejs.org now lists alpha builds first and
# nvm installs them as the latest release. The live server runs Node 26.
node_default_version: "26"

mariadb_version: "12.2"
mariadb_admin_user: "admin"

mail_domain: "example.com"
mail_admin_user: "admin"

admin_email: "admin@example.com"
security_email: "security@example.com"

dkim_domains:
  - domain: "example.com"
    selector: "mail"

vmail_group_id: 5000
vmail_user_id: 5000
vmail_home: "/var/mail/vhosts"

crowdsec_whitelist_ip: "YOUR_ADMIN_IP"

# bind9: local DNS resolver bound to 127.0.0.1 (kept on the live server)
install_bind: true

# Backups
rclone_version: "v1.76.0"
# Site content that exists nowhere else (not in git, not built by CI):
# uploads, plugins installed from the WordPress admin, custom wp-config.php...
backup_sites_paths: []
#  - "/var/www/clients/example/site/wp-config.php"
#  - "/var/www/clients/example/site/wp-content/uploads"
# Enable only once /root/.config/rclone/rclone.conf is set up by hand
backup_offsite_enabled: false
