#!/bin/bash

# Define variables
DATE=$(date +'%Y.%m.%d')
ARCHIVE_NAME="/var/backups/server/${DATE}_sites.zip"

# Only content that exists nowhere else on the server's side. Sites deployed
# from git are NOT listed: their code comes back from GitHub. Sites whose
# build is uploaded by CI ARE listed (small, and online again right after a
# restore, without a CI redeploy). The list is backup_sites_paths in
# group_vars: add any new site with user content (uploads, plugins installed
# from its admin...) or any new CI-built site.
SOURCE_PATHS=(
{% for path in backup_sites_paths | default([]) %}
    "{{ path }}"
{% endfor %}
)

# Create a temporary directory
TMP_DIR=$(mktemp -d)

EXCLUDES=(
    "--exclude=node_modules/"
    "--exclude=.well-known/"
    "--exclude=*.log"
    "--exclude=.git/"
)

# --relative keeps full paths in the archive: restore = unzip, then rsync to /
for SOURCE_PATH in "${SOURCE_PATHS[@]}"; do
    timeout 15m rsync -a --relative --max-size=256m "${EXCLUDES[@]}" "$SOURCE_PATH" "$TMP_DIR/"
done

# Restore metadata, at the archive root (not restored as files):
# - ownership.tsv: owner of each backed-up path (zip ids are not reliable
#   on a new server)
# - wordpress.tsv: WordPress sites and their version, as the core is not
#   backed up and must be re-downloaded in the same version
for SOURCE_PATH in "${SOURCE_PATHS[@]}"; do
    [ -e "$SOURCE_PATH" ] && stat -c $'%U:%G\t%n' "$SOURCE_PATH"
done > "$TMP_DIR/ownership.tsv"
find /var/www -maxdepth 8 -path '*/wp-includes/version.php' | while read -r version_file; do
    printf '%s\t%s\n' "${version_file%/wp-includes/version.php}" \
        "$(grep -oP '^\$wp_version\s*=\s*.\K[^'\''"]+' "$version_file")"
done > "$TMP_DIR/wordpress.tsv"

# Change to the temporary directory to ensure zip archives contents directly
cd "$TMP_DIR" || exit

# Replace any archive from an earlier run today (zip -r would merge into it).
# -y stores symlinks as symlinks (sites-enabled, *.wants...), not as copies
rm -f "$ARCHIVE_NAME"

# Create the archive
zip -rqy "$ARCHIVE_NAME" ./*

# Check if the archive was created successfully
if [ -f "$ARCHIVE_NAME" ]; then
    echo "Backup of sites completed successfully: $ARCHIVE_NAME"
else
    echo "ERROR: failed to create the site backup archive $ARCHIVE_NAME" >&2
fi

# Clean up
rm -rf "$TMP_DIR"
