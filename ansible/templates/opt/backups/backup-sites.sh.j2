#!/bin/bash

# Define variables
DATE=$(date +'%Y.%m.%d')
ARCHIVE_NAME="/var/backups/server/${DATE}_sites.zip"

# Discover every vhost-create-deployed site dynamically instead of a
# hardcoded list, so newly deployed sites are picked up automatically instead
# of silently going unbacked-up. backup_sites_extra_dirs (group_vars) lists
# extra folders outside /var/www/clients, e.g. user uploads of a site whose
# code lives in git and redeploys via webhook.
SOURCE_DIRS=()
shopt -s nullglob
for dir in /var/www/clients/*/; do
    SOURCE_DIRS+=("${dir%/}")
done
shopt -u nullglob
{% for dir in backup_sites_extra_dirs | default([]) %}
SOURCE_DIRS+=("{{ dir }}")
{% endfor %}

# Create a temporary directory
TMP_DIR=$(mktemp -d)

# Exclude only regenerable content. WordPress core (wp-admin, wp-includes) is
# kept: broad patterns like *cache*/*temp* used to drop core files such as
# wp-includes/class-wp-feed-cache.php, making restored sites unusable.
EXCLUDES=(
    "--exclude=wp-content/cache/"
    "--exclude=wp-content/upgrade/"
    "--exclude=node_modules/"
    "--exclude=.well-known/"
    "--exclude=*.log"
)

# Copy files to the temporary directory while excluding specific folders
for SOURCE_DIR in "${SOURCE_DIRS[@]}"; do
    # Get the base name of the source directory (to create a subdirectory)
    DIR_NAME=$(basename "$SOURCE_DIR")

    # Create a corresponding directory in the temporary directory
    mkdir -p "$TMP_DIR/$DIR_NAME"

    # Copy files to the corresponding subdirectory
    timeout 15m rsync -av --prune-empty-dirs --max-size=256m "${EXCLUDES[@]}" "$SOURCE_DIR/" "$TMP_DIR/$DIR_NAME/"
done

# Change to the temporary directory to ensure zip archives contents directly
cd "$TMP_DIR" || exit

# Create the archive
zip -r "$ARCHIVE_NAME" ./*

# Check if the archive was created successfully
if [ -f "$ARCHIVE_NAME" ]; then
    echo "Backup of sites completed successfully: $ARCHIVE_NAME"
else
    echo "Failed to create the site backup archive."
fi

# Clean up
rm -rf "$TMP_DIR"
